# Copy to `.env` and replace every value before starting the stack.
# `.env` is git-ignored: no secret ever lands in the repository.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=nakama
POSTGRES_USER=nakama
POSTGRES_PASSWORD=change-me-postgres

# --- Nakama -----------------------------------------------------------------
# Key the game clients present to open a session. Public by design, but must
# still be changed away from Nakama's "defaultkey".
NAKAMA_SOCKET_SERVER_KEY=change-me-server-key

# Secrets used to sign session and refresh tokens. Rotating them invalidates
# every issued token.
NAKAMA_SESSION_ENCRYPTION_KEY=change-me-session-encryption-key
NAKAMA_SESSION_REFRESH_ENCRYPTION_KEY=change-me-refresh-encryption-key

# Key required to call server RPCs over HTTP without a user session.
NAKAMA_RUNTIME_HTTP_KEY=change-me-http-key

# Nakama developer console credentials.
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=change-me-console-password

# --- Web client -------------------------------------------------------------
# Anything prefixed with VITE_ is embedded verbatim in the browser bundle, so
# never put a secret here. The Nakama server key is not repeated below: the
# build injects it from NAKAMA_SOCKET_SERVER_KEY above, which keeps a single
# source of truth and makes a client/server mismatch impossible.
#
# The public origin Caddy serves. The client and the API share it, so this is
# the address of the app as much as it is the address of Nakama.
VITE_NAKAMA_HOST=localhost
VITE_NAKAMA_PORT=80
VITE_NAKAMA_USE_SSL=false

# --- Caddy ------------------------------------------------------------------
# Local development uses plain http on localhost. In production set these to
# real hostnames (for example `play.example.com`) and Caddy provisions TLS
# certificates automatically.
CADDY_SITE_ADDRESS=http://localhost
CADDY_CONSOLE_ADDRESS=http://localhost:8080

# --- Production only ---------------------------------------------------------
# Read by server/docker/Caddyfile.prod, and ignored by the development stack.
#
# The second hostname, redirected to the first. Two addresses serving the same
# app would split the stored session, which is keyed by origin.
CADDY_ALIAS_ADDRESS=www.example.com
# Where Let's Encrypt writes about a certificate that is about to expire.
CADDY_ACME_EMAIL=you@example.com
