{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "rootDir": ".",
    "outDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/tsconfig.tsbuildinfo"
  },
  "include": [
